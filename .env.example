# RPC URLs (optional — falls back to public RPCs if not set)
# Public RPCs work fine and support larger getLogs ranges than Alchemy free tier.
RPC_URL_MAINNET=
RPC_URL_BASE=
RPC_URL_ARBITRUM=
RPC_URL_UNICHAIN=

# Webhook URL for new auction alerts (optional, legacy — raw JSON payload)
WEBHOOK_URL=

# Alert webhook URLs (optional, comma-separated)
# All routed alerts (auction, whale, bid-update, etc.) are sent here.
# Auto-detects Discord and Slack webhooks for native formatting.
# Generic endpoints receive: { type, text, html, timestamp, source }
ALERT_WEBHOOK_URLS=

# Email alerts via SendGrid (optional)
# ALERT_EMAIL_MODE: "digest" (daily/weekly summaries only) or "all" (every alert)
SENDGRID_API_KEY=
ALERT_EMAIL=
ALERT_EMAIL_FROM=alerts@cca-monitor.dev
ALERT_EMAIL_MODE=digest

# Telegram bot and channel IDs (optional — needed for alerts and bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PREMIUM_CHANNEL_ID=
TELEGRAM_PUBLIC_CHANNEL_ID=

# Extra CCA factory addresses to watch (optional, comma-separated)
# Use when Uniswap deploys a V3+ factory before code is updated
EXTRA_FACTORY_ADDRESSES=

# Extra RSS/Atom feeds for intent radar (optional, comma-separated)
INTENT_FEEDS=

# Article link (optional) — shown in bot /start and /stats when set
ARTICLE_URL=

# Post-graduation price tracking via DexScreener (default: false)
# When true: alerts on -10/-20/-30% moves, premium channel only, 24h cooldown
TRACK_POST_GRADUATION=

# GitHub PAT for triggering analyze workflow on new auction detection (optional)
# Needs: actions:write scope. Create at github.com/settings/tokens
GITHUB_PAT=

# Set SKIP_RPC=1 to skip online tests (offline golden tests still run)
SKIP_RPC=
